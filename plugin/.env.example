# ─────────────────────────────────────────────────────────────────────────────
# agent-tasks — cấu hình MỘT DỰ ÁN. File này là TUỲ CHỌN.
#
# Bình thường bạn KHÔNG cần nó:
#   • claimRepoUrl + GITLAB_TOKEN  → khai một lần ở ~/.agent-tasks/ (`tasks-cli setup`)
#   • gitlabHost + projectPath     → ĐỌC từ `git remote` của chính dự án
#
# Chỉ tạo `.env` khi dự án này cần KHÁC cấp máy: repo tắt Issues, muốn backlog
# riêng, hoặc cần token khác.
#
#   cp .env.example .env      (hoặc: node bin/tasks-cli.mjs init)
#
# ⚠️ `.env` ở root là file của CẢ DỰ ÁN — thường đã có sẵn cấu hình của ứng dụng.
# Muốn cấu hình chỉ cho RIÊNG clone của bạn (và không đụng file nào của dự án):
#
#   node bin/tasks-cli.mjs init --local   → <git-dir>/agent-tasks.env
#
# Tầng đó thắng file này, git không track được, và nhận đúng những khoá dưới đây.
#
# `.env` ĐÃ được .gitignore. Đừng bỏ dòng đó ra — file này chứa token.
# Biến môi trường đặt ở shell sẽ THẮNG file này, dùng để override tạm một lệnh.
#
# Kiểm sau khi điền:  node bin/tasks-cli.mjs status
# ─────────────────────────────────────────────────────────────────────────────


# ── BẮT BUỘC ─────────────────────────────────────────────────────────────────
# Thiếu bất kỳ dòng nào trong khối này ⇒ mọi tool sẽ trả "chưa cấu hình".

# URL gốc của GitLab self-hosted. KHÔNG có dấu / ở cuối, KHÔNG kèm /api/v4.
AGENT_TASKS_GITLAB_HOST=https://git.example.inc

# Project chứa work item (backlog). Dạng `group/project`, đúng như trên URL GitLab.
# Project này phải BẬT Issues.
AGENT_TASKS_PROJECT_PATH=grp/agent-backlog

# Project chứa claim ref — PHẢI là project KHÁC với backlog, và dùng URL SSH
# (claim đi qua git-over-ssh, không qua API).
# ⚠️ Project này sẽ hiện "empty repository" trên UI GitLab. Đó là ĐÚNG, không phải hỏng:
#    claim sống dưới `refs/claims/*`, mà web UI chỉ render branch và tag.
AGENT_TASKS_CLAIM_REPO_URL=git@git.example.inc:grp/agent-claims.git

# Group Access Token, scope `api`. Tạo ở group chứa CẢ HAI project trên.
# Dùng group token thay vì PAT cá nhân: rò rỉ không mở được toàn bộ tài khoản, và
# audit trail chỉ rõ bot nào sửa gì.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx


# ── TUỲ CHỌN — bỏ trống là dùng mặc định ──────────────────────────────────────
# Mọi dòng dưới đây có thể xoá hẳn. Để trống cũng được coi như chưa khai.

# Tắt agent-tasks cho riêng clone này (vẫn giữ nguyên cấu hình).
# AGENT_TASKS_ENABLED=false

# Tiền tố tách không gian claim giữa các dự án dùng chung một claim-repo.
# Bỏ trống ⇒ tự suy từ projectPath (`grp/agent-backlog` → `grp-agent-backlog`).
# AGENT_TASKS_PROJECT_KEY=auto

# Không gian ref chứa claim. Đổi cái này là đổi chỗ khoá — mọi máy phải khai GIỐNG NHAU,
# lệch nhau thì hai phiên khoá ở hai chỗ và không thấy nhau (tức là hết chống trùng).
# AGENT_TASKS_REF_NAMESPACE=refs/claims

# Claim sống bao lâu nếu không được gia hạn (giây). Mặc định 1800 = 30 phút.
# Task thường dài hơn TTL thì tăng lên, đừng để agent phải claim lại giữa việc.
# AGENT_TASKS_TTL_SEC=1800

# Chu kỳ heartbeat gia hạn claim (giây). Phải NHỎ HƠN HẲN ttlSec — thường ttl/3.
# AGENT_TASKS_HEARTBEAT_SEC=600

# Dung sai lệch đồng hồ giữa các máy (giây).
# AGENT_TASKS_SKEW_SEC=60

# Thời gian nương sau khi claim hết hạn, trước khi cho người khác giành (giây).
# AGENT_TASKS_GRACE_SEC=120

# Khoảng cách tối thiểu giữa hai lần ghi tiến độ lên cùng một item (giây) — chống spam comment.
# AGENT_TASKS_PROGRESS_MIN_INTERVAL_SEC=300

# Xử lý khi không với tới claim-repo:
#   fail-closed  KHÔNG claim (mặc định — thà không làm còn hơn hai phiên làm trùng)
#   fail-open    vẫn claim cục bộ ⚠️ MẤT bảo đảm chống trùng
# AGENT_TASKS_OFFLINE_POLICY=fail-closed


# ── NGUỒN INGEST — tài liệu nào được đưa lên thành work item ──────────────────
# AGENT_TASKS_INGEST_SPEC=true
# AGENT_TASKS_INGEST_CHANGELOG=true
# AGENT_TASKS_INGEST_BRIEF=true
# ledger tắt mặc định: nó chứa đường dẫn máy local, đưa lên GitLab là rò rỉ vô ích.
# AGENT_TASKS_INGEST_LEDGER=false


# ── ĐÍNH TÀI LIỆU LÊN WORK ITEM khi xong task ────────────────────────────────
# Nguồn nào được upload thành file đính kèm. Mặc định BẬT HẾT.
# Tách khỏi AGENT_TASKS_INGEST_* ở trên: hai luồng khác nhau, tắt cái này không ảnh hưởng cái kia.
# AGENT_TASKS_ATTACH_SPEC=true       # specs/<capability>/spec.md          → spec.md
# AGENT_TASKS_ATTACH_HANDOFF=true    # docs/releases/entries/<YYYYMM>/…    → handoff-qc.md
#
# ⚠️ Hai nguồn dưới đang GITIGNORE — đính chúng là đưa nội dung CHƯA TỪNG COMMIT lên GitLab.
#    Tắt nếu instance GitLab không đủ kín cho nội dung đó.
# AGENT_TASKS_ATTACH_LEDGER=true     # docs/wip/<lô>/verify.md             → ledger.md
# AGENT_TASKS_ATTACH_API_SPEC=true   # docs-raw/<task>/*.md trừ brief.md   → api-spec.md


# ── ĐỊNH DANH PHIÊN — hầu như không cần đặt ───────────────────────────────────
# Tên chủ claim hiện trên GitLab. Bỏ trống ⇒ lấy $USER.
# AGENT_TASKS_OWNER=

# Vai của agent, dùng để lọc hàng đợi theo `role`.
# AGENT_TASKS_ROLE=

# ⚠️ ĐỪNG đặt cái này thủ công. Hai phiên cùng sessionId sẽ coi nhau là MỘT và
#    giành được cùng một task — phá đúng thứ dự án này sinh ra để chống.
#    Bỏ trống ⇒ lấy $CLAUDE_SESSION_ID, không có thì sinh ngẫu nhiên mỗi tiến trình.
# AGENT_TASKS_SESSION_ID=
