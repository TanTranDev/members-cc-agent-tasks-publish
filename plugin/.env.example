# ─────────────────────────────────────────────────────────────────────────────
# agent-tasks — biến môi trường. File này là TUỲ CHỌN, và KHÔNG phải nơi cấu hình chính.
#
# v0.3: cấu hình của DỰ ÁN nằm ở `agent-tasks.config.json` tại root repo (commit được):
#   boardUrl · claimRepoUrl · ttlSec · heartbeatSec        → sinh bằng: node bin/tasks-cli.mjs init
# Token nằm ở ~/.agent-tasks/.env (cả máy)                 → sinh bằng: node bin/tasks-cli.mjs setup
# Override riêng MỘT clone (token khác, board khác):        → node bin/tasks-cli.mjs init --local
#
# Chỉ dùng `.env` ở root dự án khi bạn cố ý muốn override bằng biến môi trường. Mọi khoá dưới đây
# đều có thể đặt ở shell (thắng file) hoặc ở <git-dir>/agent-tasks.env.
#
# `.env` PHẢI được .gitignore — file này có thể chứa token.
# Kiểm sau khi điền:  node bin/tasks-cli.mjs status
# ─────────────────────────────────────────────────────────────────────────────


# ── BOARD & CLAIM — bình thường khai trong agent-tasks.config.json, không ở đây ─

# URL project GitLab chứa ISSUE BOARD (copy từ trình duyệt). Suy ra host + project path.
# AGENT_TASKS_BOARD_URL=https://git.example.inc/grp/agent-board

# Hoặc khai tách (thắng boardUrl nếu cùng có):
# AGENT_TASKS_GITLAB_HOST=https://git.example.inc
# AGENT_TASKS_PROJECT_PATH=grp/agent-board

# Project chứa claim ref — PHẢI là project KHÁC với board, URL SSH (claim đi qua git-over-ssh).
# Project này sẽ hiện "empty repository" trên UI GitLab — đúng, không phải hỏng.
# AGENT_TASKS_CLAIM_REPO_URL=git@git.example.inc:grp/agent-claims.git

# Group Access Token, scope `api`, tạo ở group chứa CẢ HAI project trên. Đặt ở ~/.agent-tasks/.env.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx


# ── TUỲ CHỌN — bỏ trống là dùng mặc định ──────────────────────────────────────

# Tắt agent-tasks cho riêng clone này.
# AGENT_TASKS_ENABLED=false

# Tiền tố tách không gian claim giữa các dự án dùng chung một claim-repo. Bỏ trống ⇒ suy từ projectPath.
# AGENT_TASKS_PROJECT_KEY=auto

# Không gian ref chứa claim. Mọi máy phải khai GIỐNG NHAU.
# AGENT_TASKS_REF_NAMESPACE=refs/claims

# Claim sống bao lâu nếu không gia hạn (giây). Mặc định 1800.
# AGENT_TASKS_TTL_SEC=1800

# Chu kỳ heartbeat (giây). Phải NHỎ HƠN HẲN ttlSec — thường ttl/3.
# AGENT_TASKS_HEARTBEAT_SEC=600

# AGENT_TASKS_SKEW_SEC=60
# AGENT_TASKS_GRACE_SEC=120

# Khoảng cách tối thiểu giữa hai lần ghi tiến độ lên cùng một item (giây).
# AGENT_TASKS_PROGRESS_MIN_INTERVAL_SEC=300

# fail-closed (mặc định) = KHÔNG claim khi không với tới claim-repo · fail-open ⚠️ mất bảo đảm chống trùng
# AGENT_TASKS_OFFLINE_POLICY=fail-closed


# ── NGUỒN INGEST ───────────────────────────────────────────────────────────────
# AGENT_TASKS_INGEST_SPEC=true
# AGENT_TASKS_INGEST_CHANGELOG=true
# AGENT_TASKS_INGEST_BRIEF=true
# AGENT_TASKS_INGEST_LEDGER=false


# ── ĐÍNH TÀI LIỆU LÊN WORK ITEM khi xong task ────────────────────────────────
# AGENT_TASKS_ATTACH_SPEC=true
# AGENT_TASKS_ATTACH_HANDOFF=true
# ⚠️ Hai nguồn dưới thường GITIGNORE — đính là đưa nội dung chưa commit lên GitLab.
# AGENT_TASKS_ATTACH_LEDGER=true
# AGENT_TASKS_ATTACH_API_SPEC=true


# ── ĐỊNH DANH PHIÊN — hiện trên khối "Đang làm" của item ─────────────────────
# Tên người. Bỏ trống ⇒ $USER.
# AGENT_TASKS_OWNER=

# Tên AGENT — một máy chạy nhiều agent thì đặt để người biết đúng agent nào đang giữ.
# Bỏ trống ⇒ dùng vai; không có vai ⇒ "agent".
# AGENT_TASKS_AGENT_NAME=claude-implementer-1

# Vai của agent, dùng để lọc Backlog theo `role`.
# AGENT_TASKS_ROLE=

# Id người dùng GitLab của bạn — để server set assignee lúc claim (card trên board hiện avatar).
# Cần khi token là group token (bot). Lấy ở GitLab → Profile → User ID.
# AGENT_TASKS_GITLAB_USER_ID=

# ⚠️ ĐỪNG đặt cái này thủ công. Hai phiên cùng sessionId sẽ coi nhau là MỘT.
# AGENT_TASKS_SESSION_ID=
